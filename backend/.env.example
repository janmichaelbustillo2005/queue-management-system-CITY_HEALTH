PORT=4000
FRONTEND_URL=http://localhost:3000

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Hosted backend only. NODE_ENV=production stops startup when Supabase is not configured and
# limits CORS to FRONTEND_URL, which may list several sites separated by commas.
# DATA_DIR keeps queue settings and accept state on a persistent disk.
# NODE_ENV=production
# DATA_DIR=/var/data

# Required. The backend refuses to start with this sample value or any other placeholder.
# Generate a private random value as described in README.md ("JWT signing secret").
JWT_SECRET=change-me

# Doctor dispatch. "round_robin" (RR1, the default when unset): registration assigns each patient
# to the next online (signed in) and available (counter enabled) doctor in turn, Doctor 1 -> 2 -> 3,
# whatever the service, restarting each Manila operating day; with no such doctor the registration
# is refused. Each doctor serves its own list in WPS/WPS-A order. The waiting patients of a doctor
# that goes offline are reassigned automatically, in rotation, to the doctors still available.
# Only the assigned doctor calls. Needs
# backend/scripts/20261109-rr1-round-robin-dispatch.sql and then
# backend/scripts/20261111-fc1-front-desk-confirmation.sql installed (run each preflight first).
# "service": the former fixed service-to-doctor routing (unknown services fell through to
# Doctor 1). Rollback only.
# "shared" (D1): one Weighted-Priority queue; whichever doctor calls the head of the queue takes
# the visit. Provisional; needs backend/scripts/20261029-d1-shared-call.sql.
# DOCTOR_DISPATCH_MODE=round_robin

# RR1 only: seconds between automatic dispatch passes (catches doctors whose heartbeat stopped).
# Whole number 5-60; default 15.
# DISPATCH_SWEEP_SECONDS=15

# WPS Aging (WPS-A): +1 priority per full 10 minutes waited since registration, at most +2; on an
# equal aged score the higher base category wins, then the earlier registration. Required by the
# capstone design; off when unset, so set WPS_AGING=1 to use it (render.yaml sets it for the hosted
# backend). Read once at startup: restart the backend after changing it.
# Database: in round_robin dispatch (the default) nothing beyond RR1 and FC1 is needed; their Call
# and dispatcher functions take the aging flag (qms_rr_effective_priority). Only the rollback modes
# need a separate aging function: 20261029-wps-a-call-aging.sql ("service") or
# 20261029-d1a-shared-wps-a-call.sql ("shared"), both kept in Git history before commit ffd845c.
# WPS_AGING=1

# Call uses the atomic C1 database function (backend/scripts/20261025-c1-atomic-call.sql). When it
# cannot be used, Call is refused and nothing changes. Set this to 1 only for a database that never
# had C1, to allow the older non-atomic two-statement Call. Leave unset on Supabase projects.
# ALLOW_LEGACY_TWO_STEP_CALL=0

# RES2 Residency address search (optional). A Google Maps Platform key with only the
# "Places API (New)" enabled, restricted to that API, from a project with billing on. Used by the
# backend only and never sent to browsers. Searches and Place Details are billed by Google.
# Leave unset to keep the verified 31-barangay search and manual address entry.
# GOOGLE_MAPS_API_KEY=

# SMS Gateway (GatewayAPI.com)
SMS_SENDER_NAME=Queue Management System
SMS_GATEWAY_ADDRESS=
GATEWAY_API_TOKEN=

# Voice announcer: the backend starts backend/voice/pyttsx3_tts_service.py automatically
# on Windows. Set VOICE_SERVICE_AUTOSTART=0 when the Queue Display speakers are on
# another computer and run start-voice.cmd there instead.
# VOICE_SERVICE_AUTOSTART=1
# PYTTSX3_TTS_PORT=8765
# VOICE_SERVICE_PYTHON=
