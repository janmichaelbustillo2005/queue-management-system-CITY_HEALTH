PORT=4000
FRONTEND_URL=http://localhost:3000

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Required. The backend refuses to start with this sample value or any other placeholder.
# Generate a private random value as described in README.md ("JWT signing secret").
JWT_SECRET=change-me

# Doctor dispatch (D1). "service" (default): each service goes to its fixed doctor.
# "shared": one Weighted-Priority queue; Frontdesk selects any available, signed-in doctor at
# Call. Provisional, pending administrator/adviser approval; needs
# backend/scripts/20261029-d1-shared-call.sql installed first. Leave unset on hosted projects.
# DOCTOR_DISPATCH_MODE=service

# WPS Aging (WPS-A): +1 priority per full 10 minutes waited, at most +2; a protected category wins
# ties. Provisional, off by default, pending adviser approval. Needs its database function:
# backend/scripts/20261029-wps-a-call-aging.sql (service dispatch) or
# backend/scripts/20261029-d1a-shared-wps-a-call.sql (shared dispatch). Leave unset on hosted projects.
# WPS_AGING=0

# SMS Gateway (GatewayAPI.com)
SMS_SENDER_NAME=Smart Queuing System
SMS_GATEWAY_ADDRESS=
GATEWAY_API_TOKEN=

# Voice announcer: the backend starts backend/voice/pyttsx3_tts_service.py automatically
# on Windows. Set VOICE_SERVICE_AUTOSTART=0 when the Queue Display speakers are on
# another computer and run start-voice.cmd there instead.
# VOICE_SERVICE_AUTOSTART=1
# PYTTSX3_TTS_PORT=8765
# VOICE_SERVICE_PYTHON=
